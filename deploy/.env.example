# Copy to deploy/.env. Every variable the backend reads, one comment each.
# Lines starting with '# ' are off: mail and push stay in dry-run until you uncomment them with real values.
# Keep a space before any inline comment; docker compose reads the value up to it.

# --- Infrastructure ---------------------------------------------------------
POSTGRES_PASSWORD=change-me                 # Postgres password for the `verspaetomat` role (compose builds DATABASE_URL from it)
API_DOMAIN=api.verspaetomat.de              # Public host name Caddy serves; needs an A/AAAA record to this VPS
SITE_DOMAIN=verspaetomat.de                 # The website (site/dist); Caddy also redirects www.<this> to it
ACME_EMAIL=you@example.org                  # Let's Encrypt contact for the TLS certificate
# DATABASE_URL=postgres://user:pass@host/db  # Only when not using the compose Postgres (compose sets it)
# BIND=0.0.0.0:8080                          # Listen address inside the container (compose sets it)
RUST_LOG=info,tower_http=info,sqlx=warn     # Log filter

# --- Stellwerk admin API -----------------------------------------------------
ADMIN_TOKEN=change-me-long-random           # x-admin-token for /admin/* and the `stellwerk` CLI; Caddy hides /admin from the internet, use it via `docker compose exec api stellwerk …`

# --- Outbound mail (the relay) ---------------------------------------------
# POSTMARK_TOKEN=                             # Postmark server API token; preferred over SMTP_URL because Postmark then reports errors synchronously (a pending-approval 412 shows up in `stellwerk mail-test`)
# SMTP_URL=smtp://postmark-token:postmark-token@smtp.postmarkapp.com:587   # Postmark: STARTTLS on 587, token as user and password; smtps:// = implicit TLS (465) elsewhere; unset = dry-run
# SMTP_URL=smtp://user:pass@email-smtp.eu-central-1.amazonaws.com:587     # Amazon SES alternative

# --- Relay addresses and inbound mail -------------------------------------
# Where claim mail goes is NOT set here. It lives in the mail_routes table and nowhere else:
#   stellwerk --prod route list
#   stellwerk --prod route set "Servicecenter Fahrgastrechte" du@example.org --label "Probelauf"
# An empty table means nothing can be sent. There is no environment variable to forget.
# RELAY_DOMAIN=users.verspaetomat.de         # Domain of the per-customer relay addresses fahrgast-XXXX@…; MX and inbound domain in Postmark point here
# INBOUND_SECRET=change-me-long-random        # Must match the ?secret= in the provider's webhook URL. Without it no answer can accept, refuse or ask (the sender cannot be verified)
# INBOUND_RAW_TRUSTS_SPAM_TESTS=1             # Only if the upstream posting to /internal/inbound-mail/raw writes X-Spam-Tests itself and drops copies that came with the mail

# --- Reading the railway's answers ---------------------------------------
# Without a key the rules in classify.rs read every reply. With one, a model reads it too, and every
# answer is checked against the mail before money moves (backend/src/reply.rs). The text it gets has
# the passenger taken out (redact.rs). Needs a signed data processing agreement with OpenAI.
# OPENAI_API_KEY=sk-proj-…                    # OpenAI project key; unset = rules only
# OPENAI_MODEL=gpt-5.4-mini-2026-03-17        # Pinned snapshot; change deliberately, then try `stellwerk read-mail` on real replies
# OPENAI_CONFIRM_MODEL=gpt-5.5-2026-04-23     # Second reader, asked only when the first would accept or refuse; both must agree. Empty = off
# OPENAI_BASE_URL=https://api.openai.com/v1   # Only for a compatible proxy

# --- Push: Apple (all four APNS_* together, or none; a set APNS_KEY_P8 that does not exist stops the API from starting) ---
# APNS_KEY_P8=/secrets/AuthKey_ABC123DEF4.p8  # Path to the APNs auth key (.p8) inside the container (deploy/secrets/ is mounted at /secrets)
# APNS_KEY_P8_BASE64=                       # Alternative to the path: the .p8 file base64-encoded
# APNS_KEY_ID=ABC123DEF4                      # Key ID shown next to the key in App Store Connect
# APNS_TEAM_ID=TEAM123456                     # Apple Developer Team ID
# APNS_TOPIC=de.verspaetomat.verspaetomat     # The app's bundle id
# APNS_SANDBOX=0                              # 1 for development builds / TestFlight installs from Xcode, 0 for App Store and TestFlight-from-App-Store-Connect

# --- Push: Android ----------------------------------------------------------
# FCM_SERVICE_ACCOUNT_JSON=/secrets/firebase-service-account.json   # Firebase service account key with the Cloud Messaging role; unset = dry-run for Android

# --- Train data -------------------------------------------------------------
# TRANSITOUS_URL=https://api.transitous.org  # MOTIS endpoint; default is the public Transitous instance
