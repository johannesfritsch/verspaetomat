# Copy to deploy/.env. Every variable the backend reads, one comment each.

# --- Infrastructure ---------------------------------------------------------
POSTGRES_PASSWORD=change-me                 # Postgres password for the `verspaetomat` role (compose builds DATABASE_URL from it)
API_DOMAIN=api.verspaetomat.de              # Public host name Caddy serves; needs an A/AAAA record to this VPS
ACME_EMAIL=you@example.org                  # Let's Encrypt contact for the TLS certificate
# DATABASE_URL=postgres://user:pass@host/db  # Only when not using the compose Postgres (compose sets it)
# BIND=0.0.0.0:8080                          # Listen address inside the container (compose sets it)
RUST_LOG=info,tower_http=info,sqlx=warn     # Log filter

# --- Stellwerk admin API -----------------------------------------------------
ADMIN_TOKEN=change-me-long-random           # x-admin-token for /admin/* and the `stellwerk` CLI; Caddy hides /admin from the internet, use it via `docker compose exec api stellwerk …`

# --- Outbound mail (the relay) ---------------------------------------------
SMTP_URL=smtps://postmark-token:postmark-token@smtp.postmarkapp.com:465   # smtps:// implicit TLS, smtp:// STARTTLS (port 587); unset = dry-run, nothing leaves
# SMTP_URL=smtp://user:pass@email-smtp.eu-central-1.amazonaws.com:587     # Amazon SES alternative

# --- Inbound mail (railway replies to fahrgast-*@verspaetomat.de) -----------
INBOUND_SECRET=change-me-long-random        # Must match the ?secret= in the provider's webhook URL for /internal/inbound-mail/raw

# --- Push: Apple (all four APNS_* together, or none) ------------------------
APNS_KEY_P8=/secrets/AuthKey_ABC123DEF4.p8  # Path to the APNs auth key (.p8) inside the container (deploy/secrets/ is mounted at /secrets)
# APNS_KEY_P8_BASE64=                       # Alternative to the path: the .p8 file base64-encoded
APNS_KEY_ID=ABC123DEF4                      # Key ID shown next to the key in App Store Connect
APNS_TEAM_ID=TEAM123456                     # Apple Developer Team ID
APNS_TOPIC=de.verspaetomat.verspaetomat     # The app's bundle id
APNS_SANDBOX=0                              # 1 for development builds / TestFlight installs from Xcode, 0 for App Store and TestFlight-from-App-Store-Connect

# --- Push: Android ----------------------------------------------------------
FCM_SERVICE_ACCOUNT_JSON=/secrets/firebase-service-account.json   # Firebase service account key with the Cloud Messaging role; unset = dry-run for Android

# --- Train data -------------------------------------------------------------
# TRANSITOUS_URL=https://api.transitous.org  # MOTIS endpoint; default is the public Transitous instance
